{{<layout/default}}
{{$title}}ダッシュボード{{/title}}
{{$content}}
<div class="bg-white shadow overflow-hidden sm:rounded-lg">
    <div class="px-4 py-5 sm:px-6 flex justify-between items-center">
        <div>
            <h3 class="text-lg leading-6 font-medium text-gray-900">目標一覧</h3>
            <p class="mt-1 max-w-2xl text-sm text-gray-500">あなたの目標と成果指標の進捗状況</p>
        </div>
        <a href="/objectives/new" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
            新規目標作成
        </a>
    </div>
    <div class="border-t border-gray-200">
        {{#objectives}}
        <div class="px-4 py-5 sm:px-6">
            <div class="flex justify-between items-start">
                <div>
                    <h4 class="text-lg font-medium text-gray-900">{{title}}</h4>
                    <p class="mt-1 text-sm text-gray-500">{{description}}</p>
                </div>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium {{#isCompleted}}bg-green-100 text-green-800{{/isCompleted}}{{^isCompleted}}bg-yellow-100 text-yellow-800{{/isCompleted}}">
                    {{status}}
                </span>
            </div>
            <div class="mt-4">
                <h5 class="text-sm font-medium text-gray-900">成果指標</h5>
                <div class="mt-2 space-y-4">
                    {{#keyResults}}
                    <div class="flex items-center justify-between">
                        <div class="flex-1">
                            <p class="text-sm text-gray-900">{{description}}</p>
                            <div class="mt-1 w-full bg-gray-200 rounded-full h-2.5">
                                <div class="bg-indigo-600 h-2.5 rounded-full" style="width: {{progress}}%"></div>
                            </div>
                        </div>
                        <span class="ml-4 text-sm text-gray-500">{{progress}}%</span>
                    </div>
                    {{/keyResults}}
                </div>
            </div>
            <div class="mt-4 flex justify-end space-x-3">
                <a href="/objectives/{{id}}/edit" class="inline-flex items-center px-3 py-1.5 border border-gray-300 shadow-sm text-sm font-medium rounded text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    編集
                </a>
                <button onclick="updateStatus('{{id}}')" class="inline-flex items-center px-3 py-1.5 border border-transparent text-sm font-medium rounded shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    完了にする
                </button>
            </div>
        </div>
        {{/objectives}}
    </div>
</div>

<script>
function updateStatus(objectiveId) {
    fetch(`/api/personal-objectives/${objectiveId}/status`, {
        method: 'PUT',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify({
            status: 'COMPLETED'
        })
    }).then(() => {
        window.location.reload();
    });
}
</script>
{{/content}}
{{/layout/default}} 
